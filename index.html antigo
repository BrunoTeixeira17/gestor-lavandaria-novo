<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestor de Lavandaria</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      color: #1f2937;
    }
    header {
      background: #0f172a;
      color: white;
      padding: 20px;
    }
    header h1 { margin: 0 0 6px; }
    header p { margin: 0; opacity: .8; }
    main {
      max-width: 1100px;
      margin: 30px auto;
      padding: 0 18px;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }
    .card {
      background: white;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 2px 10px rgba(0,0,0,.06);
    }
    .card small { color: #64748b; }
    .value { font-size: 28px; font-weight: bold; margin-top: 8px; }
    section {
      background: white;
      border-radius: 12px;
      padding: 22px;
      box-shadow: 0 2px 10px rgba(0,0,0,.06);
      margin-bottom: 24px;
    }
    h2 { margin-top: 0; }
    form {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr auto;
      gap: 12px;
      align-items: end;
    }
    label { display: block; font-size: 14px; font-weight: bold; margin-bottom: 6px; }
    input, select, button {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 15px;
    }
    button {
      border: 0;
      background: #2563eb;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }
    button:hover { opacity: .9; }
    .danger { background: #dc2626; }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
    }
    th, td {
      text-align: left;
      padding: 12px 8px;
      border-bottom: 1px solid #e2e8f0;
    }
    .empty {
      color: #64748b;
      text-align: center;
      padding: 24px;
    }
    @media (max-width: 800px) {
      .cards { grid-template-columns: 1fr; }
      form { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <header>
    <h1>Gestor de Lavandaria</h1>
    <p>Nova aplicação — módulo de faturação</p>
  </header>

  <main>
    <div class="cards">
      <div class="card">
        <small>Faturação de hoje</small>
        <div class="value" id="todayTotal">0,00 €</div>
      </div>
      <div class="card">
        <small>Faturação do mês</small>
        <div class="value" id="monthTotal">0,00 €</div>
      </div>
      <div class="card">
        <small>Total de registos</small>
        <div class="value" id="recordCount">0</div>
      </div>
    </div>

    <section>
      <h2>Registar faturação</h2>
      <form id="billingForm">
        <div>
          <label for="date">Data</label>
          <input id="date" type="date" required>
        </div>
        <div>
          <label for="amount">Valor (€)</label>
          <input id="amount" type="number" min="0" step="0.01" value="0" required>
        </div>
        <div>
          <label for="description">Descrição</label>
          <input id="description" type="text" placeholder="Ex.: Lavandaria">
        </div>
        <button type="submit">Guardar</button>
      </form>
    </section>

    <section>
      <h2>Faturação registada</h2>
      <table>
        <thead>
          <tr>
            <th>Data</th>
            <th>Descrição</th>
            <th>Valor</th>
            <th>Ação</th>
          </tr>
        </thead>
        <tbody id="billingTable"></tbody>
      </table>
      <div id="emptyMessage" class="empty">Ainda não existem registos.</div>
    </section>
  </main>

  <script>
    const STORAGE_KEY = "gestor_lavandaria_faturacao";
    const form = document.getElementById("billingForm");
    const dateInput = document.getElementById("date");
    const amountInput = document.getElementById("amount");
    const descriptionInput = document.getElementById("description");
    const table = document.getElementById("billingTable");
    const emptyMessage = document.getElementById("emptyMessage");

    let records = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");

    function money(value) {
      return Number(value).toLocaleString("pt-PT", {
        style: "currency",
        currency: "EUR"
      });
    }

    function todayString() {
      const d = new Date();
      const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000);
      return local.toISOString().slice(0, 10);
    }

    dateInput.value = todayString();

    function save() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
    }

    function render() {
      table.innerHTML = "";

      if (!records.length) {
        emptyMessage.style.display = "block";
      } else {
        emptyMessage.style.display = "none";
      }

      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, "0");
      const monthPrefix = `${year}-${month}`;
      const today = todayString();

      let todayTotal = 0;
      let monthTotal = 0;

      records.forEach(r => {
        const value = Number(r.amount) || 0;

        if (r.date === today) todayTotal += value;
        if (r.date.startsWith(monthPrefix)) monthTotal += value;

        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${r.date}</td>
          <td>${escapeHtml(r.description || "")}</td>
          <td>${money(value)}</td>
          <td>
            <button class="danger" onclick="removeRecord('${r.id}')">Apagar</button>
          </td>
        `;
        table.appendChild(tr);
      });

      document.getElementById("todayTotal").textContent = money(todayTotal);
      document.getElementById("monthTotal").textContent = money(monthTotal);
      document.getElementById("recordCount").textContent = records.length;
    }

    function escapeHtml(text) {
      return String(text)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    window.removeRecord = function(id) {
      if (!confirm("Apagar este registo?")) return;
      records = records.filter(r => r.id !== id);
      save();
      render();
    };

    form.addEventListener("submit", function(event) {
      event.preventDefault();

      const record = {
        id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now()),
        date: dateInput.value,
        amount: Number(amountInput.value) || 0,
        description: descriptionInput.value.trim()
      };

      records.push(record);
      records.sort((a, b) => b.date.localeCompare(a.date));
      save();
      render();

      amountInput.value = "0";
      descriptionInput.value = "";
    });

    render();
  </script>
</body>
</html>
